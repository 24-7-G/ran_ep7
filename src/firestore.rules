rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.uid == "oKGRQDdmiXUFuyRPDw5QsPBmsAD2"
          || (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
            && (get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true
              || get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.status == "active")));
    }


    // ADMINISTRATOR DIRECTORY
    // A new Firebase Auth identity may create ONLY its own adminUsers record,
    // and ONLY when it can prove that it owns a PIN-verified registration request.
    match /adminUsers/{id} {
      allow read: if signedIn() && (request.auth.uid == id || isAdmin());

      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == id
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.active == true
          && request.resource.data.role == "admin"
          && request.resource.data.status == "active"
          && request.resource.data.registrationRequestId is string
          && exists(/databases/$(database)/documents/adminRequests/$(request.resource.data.registrationRequestId))
          && get(/databases/$(database)/documents/adminRequests/$(request.resource.data.registrationRequestId)).data.status == "verified_pending_auth"
          && get(/databases/$(database)/documents/adminRequests/$(request.resource.data.registrationRequestId)).data.email == request.auth.token.email
          && (
            (exists(/databases/$(database)/documents/adminSettings/security)
              && get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash is string
              && get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash != ""
              && get(/databases/$(database)/documents/adminRequests/$(request.resource.data.registrationRequestId)).data.pinHash == get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash)
            || ((!exists(/databases/$(database)/documents/adminSettings/security)
              || (get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash is string
                  && get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash == ""))
              && get(/databases/$(database)/documents/adminRequests/$(request.resource.data.registrationRequestId)).data.pinHash == "8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92")
          ));

      allow update, delete: if isAdmin();
    }

    // NEW ADMIN REGISTRATION
    // The browser may create a harmless pending proof document while signed out.
    // The SECURITY GATE is the update from pending_pin -> verified_pending_auth.
    // That update is allowed only when the submitted SHA-256 PIN proof matches
    // the current administrator registration PIN hash. Firebase Authentication
    // is called by the app ONLY after that update succeeds.
    function validAdminRegistrationPin() {
      return (
        (exists(/databases/$(database)/documents/adminSettings/security)
          && get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash is string
          && get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash != ""
          && request.resource.data.pinHash == get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash)
        ||
        ((!exists(/databases/$(database)/documents/adminSettings/security)
          || (get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash is string
              && get(/databases/$(database)/documents/adminSettings/security).data.registrationPinHash == ""))
          && request.resource.data.pinHash == "8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92")
      );
    }

    match /adminRequests/{id} {
      // Signed-out users can create ONLY a pending proof request. This is not
      // administrator access and does not create a Firebase Auth account.
      allow create: if !signedIn()
        && !exists(/databases/$(database)/documents/adminRequests/$(id))
        && request.resource.data.status == "pending_pin"
        && request.resource.data.requestedByUid == ""
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.pinHash is string
        && request.resource.data.pinHash.size() == 64;

      allow read: if isAdmin();

      // THIS IS THE ACTUAL PIN CHECK.
      // A wrong PIN fails here, before Firebase Authentication is called.
      allow update: if isAdmin()
        || (!signedIn()
          && resource.data.status == "pending_pin"
          && request.resource.data.status == "verified_pending_auth"
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.pinHash == resource.data.pinHash
          && request.resource.data.requestedByUid == ""
          && validAdminRegistrationPin())
        || (signedIn()
          && resource.data.status == "verified_pending_auth"
          && request.resource.data.status == "verified"
          && request.resource.data.pinHash == resource.data.pinHash
          && request.resource.data.email == resource.data.email
          && request.resource.data.displayName == resource.data.displayName
          && request.resource.data.requestedByUid == request.auth.uid);

      allow delete: if isAdmin();
    }

    match /adminSettings/{id} {
      allow read, write: if isAdmin();
    }

    // Backup metadata is administrator-only. The actual JSON/XLSX payloads
    // Backup files are downloaded locally; Firestore stores backup metadata only.
    match /adminBackups/{id} {
      allow read, write: if isAdmin();
    }

    match /guildNoticeArchives/{id} {
      allow read, write: if isAdmin();
    }

    // Protected 90-day recovery archives. Only active administrators can
    // create, inspect, restore, or purge archived application data.
    match /adminArchives/{id} {
      allow read, write: if isAdmin();
    }

    match /adminArchiveChunks/{id} {
      allow read, write: if isAdmin();
    }

    // RAID SCHEDULES
    // RaidPage uses the shared "raids" collection. Raid schedules are
    // intentionally editable by ANY visitor (regular user or admin).
    // This is a deliberate exception to the normal admin-only write rules.
    match /raids/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
        "id", "name", "type", "scheduleType", "days",
        "hour", "minute", "intervalHours", "anchorDate",
        "anchorHour", "anchorMinute", "timezone", "active",
        "updatedAt", "updatedBy", "updatedByUid"
      ]);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "id", "name", "type", "scheduleType", "days",
        "hour", "minute", "intervalHours", "anchorDate",
        "anchorHour", "anchorMinute", "timezone", "active",
        "updatedAt", "updatedBy", "updatedByUid"
      ]);
      allow delete: if false;
    }

    // Legacy schedule collection retained for compatibility with older data.
    match /raidSchedules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // GUILD QUESTIONS / TICKETS
    // Preserve current ownership behavior. Administrators can manage any ticket;
    // authenticated users can manage their own tickets.
    match /guildTickets/{ticketId} {
      allow read: if true;

      allow create: if isAdmin()
        || (
          request.auth != null
          && request.resource.data.createdByUid == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          request.auth != null
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid == resource.data.createdByUid
        );

      allow delete: if isAdmin()
        || (
          request.auth != null
          && resource.data.createdByUid == request.auth.uid
        );
    }

    // Existing app collections: public read, admin write.
    match /players/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bhAttendance/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bhBalances/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bhRewards/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cwPlayers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cwAttendance/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cwSchedules/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /cwSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /guildNotices/{id} {
      allow read: if true;
      // Raid schedule edits are public by design, and their audit entries
      // must therefore be writable by the same users. Other notices remain
      // administrator-only.
      allow create: if isAdmin()
        || (request.resource.data.entityType == "raid-schedule"
          && request.resource.data.module == "raid-schedule");
      allow update, delete: if isAdmin();
    }

    match /treasuryEntries/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /treasuryConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
