rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ============================================================
     * USERS
     * ============================================================
     *
     * Users can read their own user document.
     * Admins can read/write user documents.
     */
    match /users/{userId} {
      allow read: if request.auth != null &&
        (
          request.auth.uid == userId ||
          isAdmin()
        );

      allow create: if request.auth != null &&
        request.auth.uid == userId;

      allow update: if request.auth != null &&
        (
          request.auth.uid == userId ||
          isAdmin()
        );

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * RAID SCHEDULES
     * ============================================================
     *
     * IMPORTANT:
     * EVERY LOGGED-IN USER CAN CHANGE RAID TIMES.
     *
     * Admin is NOT required here.
     */
    match /raidSchedules/{raidId} {
      allow read: if true;

      allow create, update: if request.auth != null;

      allow delete: if request.auth != null;
    }


    /*
     * ============================================================
     * RAID ATTENDANCE
     * ============================================================
     *
     * Logged-in users can record/update attendance.
     * Admin can do everything.
     */
    match /raidAttendance/{attendanceId} {
      allow read: if true;

      allow create, update: if request.auth != null;

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * ATTENDANCE
     * ============================================================
     *
     * If your app uses a general attendance collection.
     */
    match /attendance/{attendanceId} {
      allow read: if true;

      allow create, update: if request.auth != null;

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * PLAYERS
     * ============================================================
     */
    match /players/{playerId} {
      allow read: if true;

      allow create, update: if request.auth != null;

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * GUILD MEMBERS
     * ============================================================
     */
    match /guildMembers/{memberId} {
      allow read: if true;

      allow create, update: if request.auth != null;

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * GUILD
     * ============================================================
     */
    match /guild/{guildId} {
      allow read: if true;

      allow create, update: if request.auth != null;

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * CASTLE WAR
     * ============================================================
     */
    match /castleWar/{documentId} {
      allow read: if true;

      allow create, update: if request.auth != null;

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * CASTLE WAR SETTINGS
     * ============================================================
     */
    match /castleWarSettings/{documentId} {
      allow read: if true;

      allow create, update: if isAdmin();

      allow delete: if isAdmin();
    }


    /*
     * ============================================================
     * SETTINGS
     * ============================================================
     */
    match /settings/{settingId} {
      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    /*
     * ============================================================
     * ADMIN CHECK
     * ============================================================
     *
     * Your current admin UID.
     */
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == "oKGRQDdmiXUFuyRPDw5QsPBmsAD2";
    }


    /*
     * ============================================================
     * DEFAULT DENY
     * ============================================================
     *
     * Anything not explicitly listed above is denied.
     */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}